{
  "name": "aure-relics-grid",
  "version": "0.9.0-alpha.0",
  "private": true,
  "description": "Aure Relics Battle Grid v0.9 scaffold using Vite and plain JavaScript.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/verify-vite-scaffold.mjs && node --test tests/*.test.js",
    "test:db": "supabase test db",
    "test:api": "node scripts/test-supabase-api.mjs && node scripts/test-entry-api.mjs && node scripts/test-characters-api.mjs",
    "test:characters-api": "node scripts/test-characters-api.mjs",
    "test:entry-api": "node scripts/test-entry-api.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local"
  },
  "keywords": [
    "aure-relics",
    "battle-grid",
    "tabletop",
    "vite"
  ],
  "author": "FlowForge LLC",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.0",
    "supabase": "2.117.0",
    "vite": "^6.4.3"
  }
}
