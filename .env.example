# Copy to .env.local. Leave blank to keep using the offline board.
# All VITE_* values are public browser configuration, never secrets.
# Use your project's HTTPS origin; Aure Relics local CLI uses http://127.0.0.1:56321.

VITE_SUPABASE_URL=
# Recommended: sb_publishable_... from Supabase Project Settings > API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional compatibility fallback: legacy JWT whose role is anon.
VITE_SUPABASE_ANON_KEY=
# Never add a service_role JWT, sb_secret_ key, database password, or CLI token here.
# Deployment/migration credentials belong only in protected CLI/server environments.
